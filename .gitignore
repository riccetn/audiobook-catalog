# Your Hardcover API token: it gives access to your Hardcover account.
data/hardcover-token
# Left behind only if `make serve` is stopped in the middle of saving.
data/.*.tmp

# Raw exports contain ratings, reviews and purchase history.
data/raw/*
!data/raw/.gitkeep

