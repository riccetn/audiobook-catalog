{%- comment -%}
	The page of one author, narrator or publisher (credit.ts), whose template only names the kind: author.liquid,
	narrator.liquid and publisher.liquid. kind: "author", "narrator" or "publisher".
{%- endcomment %}
	<p class="sub" id="subtitle">Loading&hellip;</p>

	<div class="crumb show" id="crumb">
		<a href="{{ kind }}s.html">&larr; All {{ kind }}s</a>
	</div>

	<div id="bgTask" class="bgTask" role="status" aria-live="polite"></div>
	<p id="ioStatus" class="ioStatus" role="status"></p>

	<form id="creditForm" class="creditForm">
		<h3 id="creditFormTitle">Edit {{ kind }}</h3>
		<div><label for="cf_name">Name (renames them on every book that credits them)</label><input id="cf_name"></div>
		<div><label for="cf_bio">Short bio</label><textarea id="cf_bio" rows="4"></textarea></div>
		<div><label for="cf_url" id="cf_url_label">Website</label><input id="cf_url" placeholder="https://"></div>
		<div class="formrow extFields" id="cf_ext"></div>
		<div id="cf_linksBox"></div>
		<p id="creditFormError" class="formError"></p>
		<div class="formbtns">
			<button type="submit" class="save" id="creditSaveBtn">Save {{ kind }}</button>
			<button type="button" id="cancelCredit">Cancel</button>
			<button type="button" id="creditRemoveBtn" class="removeBook">Remove {{ kind }}</button>
		</div>
	</form>

	<div id="creditBody"></div>
