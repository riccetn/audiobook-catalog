{% layout 'layout' nav: 'index.html' script: 'series.js' %}
	<p class="sub" id="subtitle">Loading&hellip;</p>
	<p class="backupNudge" id="backupNudge"></p>

	<div class="crumb" id="crumb">
		<a href="index.html">&larr; All series</a>
		<span id="crumbLabel"></span>
	</div>

	<div class="controls" id="controls">
		<input type="text" id="q" placeholder="Search series and authors&hellip;">
		<button type="button" id="filtersBtn" class="filtersBtn" aria-expanded="false" aria-controls="missingFilter">Filters</button>
		<select id="missingFilter"><option value="">All series</option><option value="missing">Series with missing books</option></select>
	</div>

	<div class="count-row">
		<span id="resultCount"></span>
		<div class="rowbtns">
			<label class="coversToggle" title="Covers are fetched from Amazon and Open Library by the books' ASINs and ISBNs"><input type="checkbox" id="showCovers" checked> Covers</label>
			<a class="addbtn" id="toggleAdd" href="book.html#add">+ Add a book</a>
		</div>
	</div>
	<div id="bgTask" class="bgTask" role="status" aria-live="polite"></div>
	<p id="ioStatus" class="ioStatus"></p>

	<form id="seriesForm">
		<h3 id="seriesFormTitle">Edit series</h3>
		<div><label for="sf_name">Series name (renames it on every book in the series)</label><input id="sf_name"></div>
		<div class="formrow">
			<div><label for="sf_total">Books released so far</label><input id="sf_total" placeholder="e.g. 12, or many"></div>
			<div><label for="sf_status">Status</label><select id="sf_status"><option value="ongoing">ongoing</option><option value="complete">complete</option></select></div>
		</div>
		<div><label for="sf_note">Note</label><input id="sf_note" placeholder="e.g. book 5 is announced"></div>
		<div><label for="sf_url">Author or publisher site (optional)</label><input id="sf_url" placeholder="https://"></div>
		<div class="formrow extFields" id="sf_ext"></div>
		<p id="seriesFormError" class="formError"></p>
		<div class="formbtns">
			<button type="submit" class="save" id="seriesSaveBtn">Save series</button>
			<button type="button" id="seriesRemoveBtn" class="removeBook">Remove series</button>
			<button type="button" id="cancelSeries">Cancel</button>
		</div>
	</form>

	<div id="results"></div>
