{% layout 'layout' title: 'Import &amp; export' nav: 'import.html' script: 'import.js' %}
	<p class="sub" id="subtitle">Loading&hellip;</p>
	<div id="bgTask" class="bgTask" role="status" aria-live="polite"></div>
	<p id="ioStatus" class="ioStatus" role="status"></p>

	<section class="panel setupReceived" id="setupReceived" style="display:none">
		<h2>Settings from another device</h2>
		<p>This link brings these settings, which are kept in this browser only (never in a backup):</p>
		<ul id="setupReceivedList"></ul>
		<div class="rowbtns">
			<button class="iconbtn2" id="setupReceivedSave" title="Keep these settings in this browser">Save these settings</button>
			<button class="iconbtn2" id="setupReceivedSkip" title="Forget the link and save nothing">Don't save</button>
		</div>
	</section>

	<h2 class="pageSection">This catalog</h2>

	<section class="panel" id="backupPanel">
		<h2>Backups <span class="via">JSON file</span></h2>
		<div class="ioRow">
			<span class="ioLabel">Backup</span>
			<div class="rowbtns">
				<button class="iconbtn2" id="exportBtn" title="Download a backup JSON file">Export</button>
				<button class="iconbtn2" id="importBtn" title="Restore from a backup JSON file, or from data files">Restore</button>
				<button class="iconbtn2" id="mergeBtn" title="Merge a backup from another device into this catalog">Merge</button>
				<input type="file" id="importFile" accept="application/json,.json,.txt,text/plain" multiple style="display:none">
				<input type="file" id="mergeFile" accept="application/json" style="display:none">
			</div>
			<p class="ioNote">The catalog lives in this browser only, so export a backup now and then: it has the books, the series, authors, narrators and
				publishers, and the list of books imports skip. Restore replaces the catalog with a backup, or with the data files of a catalog
				from before it lived in the browser (pick <code>books.json</code>, <code>series-info.json</code>, <code>authors.json</code>,
				<code>excluded.txt</code> and <code>not-duplicates.txt</code> together). Merge combines a backup from another device (your phone, say) with this catalog when both have changed.</p>
			<p class="ioNote backupState" id="backupState"></p>
		</div>
	</section>

	<section class="panel" id="checkPanel">
		<h2>Check</h2>
		<div class="ioRow">
			<span class="ioLabel">Check</span>
			<div class="rowbtns">
				<button class="iconbtn2" id="checkBtn" title="Check the books, series and people for problems">Check</button>
				<button class="iconbtn2" id="boxSetsBtn" title="Keep each box set as its own book and as its titles">Box sets</button>
			</div>
			<p class="ioNote">Check lists errors and anything that needs a look. Box sets keeps each box set both as its own book and
				as its titles, as imports do now; it shows what it would add before changing anything.</p>
		</div>
		<div class="ioRow">
			<span class="ioLabel">Excluded</span>
			<div class="rowbtns">
				<button class="iconbtn2" id="exclusionsBtn" title="List the books and editions imports skip">Show</button>
			</div>
			<p class="ioNote">The books you removed, and the editions you removed and kept out, which imports never add again.
				Remove one from the list to let imports add it again.</p>
			<div id="exclusionsList"></div>
		</div>
	</section>

	<h2 class="pageSection">External catalogs</h2>
	<p class="hint">Each import shows the other catalog's books beside yours first, and takes only what you tick: new books, what it has that
		yours lack, and, where both have a value that differs, the values you pick. Nothing is ever removed.</p>

	{%- comment -%}
		A panel per external catalog the app imports from, exports to or compares shelves with: `panels` is
		CatalogConnectors.panels(), which make pages (build.mjs) reads from the catalogs' classes, so no catalog is
		named here. A panel's ids start with its catalog (import.js finds them by it).
	{%- endcomment %}
	{%- for panel in panels %}
	<section class="panel" id="{{ panel.catalog }}Panel">
		<h2>{{ panel.label }} <span class="via">{{ panel.via }}</span></h2>
		{%- if panel.importer %}
		<div class="ioRow">
			<span class="ioLabel">Import</span>
			<div class="rowbtns">
				{%- if panel.importer.sites.size > 0 %}
				<label>From
					<select id="{{ panel.catalog }}ImportSite" title="The {{ panel.label }} site your library export is from">
						{%- for site in panel.importer.sites %}
						<option value="{{ site }}">{{ site }}</option>
						{%- endfor %}
					</select></label>
				{%- endif %}
				<button class="iconbtn2" id="{{ panel.catalog }}ImportBtn" title="{{ panel.importer.title }}">Import CSV</button>
			</div>
			<p class="ioNote">{{ panel.importer.note }}</p>
		</div>
		{%- endif %}
		{%- if panel.exporter %}
		<div class="ioRow">
			<span class="ioLabel">Export</span>
			<div class="rowbtns">
				<button class="iconbtn2" id="{{ panel.catalog }}ExportBtn" title="{{ panel.exporter.title }}">Download {{ panel.exporter.format }}</button>
			</div>
			<p class="ioNote">{{ panel.exporter.note }}</p>
		</div>
		{%- endif %}
		{%- if panel.compare %}
		<div class="ioRow">
			<span class="ioLabel">Compare</span>
			<div class="rowbtns">
				<button class="iconbtn2" id="{{ panel.catalog }}CompareBtn" title="Compare your {{ panel.label }} shelves with this catalog">Compare</button>
			</div>
			<p class="ioNote">{{ panel.compare.note }}</p>
		</div>
		{%- endif %}
		{%- if panel.key %}
		<div class="ioRow">
			<span class="ioLabel">{{ panel.key.name }}</span>
			<div class="rowbtns">
				<input type="password" id="{{ panel.catalog }}Key" placeholder="{{ panel.label }} {{ panel.key.name }}" autocomplete="off" spellcheck="false">
				<button class="iconbtn2" id="{{ panel.catalog }}KeySave" title="Keep this {{ panel.key.word }} in this browser">Save {{ panel.key.word }}</button>
				<button class="iconbtn2" id="{{ panel.catalog }}KeyRemove" title="Forget the {{ panel.key.word }} in this browser">Remove {{ panel.key.word }}</button>
			</div>
			<p class="ioNote" id="{{ panel.catalog }}KeyState"></p>
		</div>
		{%- endif %}
		{%- if panel.note != '' %}
		<p class="ioNote">{{ panel.note }}</p>
		{%- endif %}
	</section>
	{%- endfor %}

	<section class="panel" id="serverPanel">
		<h2>Your server <span class="via">Optional</span></h2>
		<div class="ioRow">
			<span class="ioLabel">Server</span>
			<div class="rowbtns">
				<input type="url" id="serverUrl" placeholder="https://your-server.workers.dev" autocomplete="off" spellcheck="false">
				<input type="password" id="serverKey" placeholder="Server key" autocomplete="off" spellcheck="false">
				<button class="iconbtn2" id="serverSave" title="Keep this server in this browser, and see that it answers">Save server</button>
				<button class="iconbtn2" id="serverCheck" title="See that the saved server answers">Check</button>
				<button class="iconbtn2" id="serverRemove" title="Forget the server in this browser">Remove server</button>
			</div>
			<p class="ioNote">A server of your own does two things for this app: its catalog proxy asks the catalogs that don't answer
				web pages, and it keeps the copy your devices sync with. It is a small
				Cloudflare Worker, free, or <code>make serve</code> on your computer; the app's docs (<em>Your server</em>) show how to
				set it up. Everything else works without it.</p>
			<p class="ioNote" id="serverState"></p>
		</div>
	</section>

	<section class="panel" id="syncPanel">
		<h2>Sync between devices <span class="via">Through your server</span></h2>
		<div class="ioRow">
			<span class="ioLabel">Passphrase</span>
			<div class="rowbtns">
				<input type="password" id="syncPassphrase" placeholder="Sync passphrase" autocomplete="off" spellcheck="false">
				<button class="iconbtn2" id="syncPassphraseSave" title="Keep this passphrase in this browser">Save passphrase</button>
				<button class="iconbtn2" id="syncPassphraseRemove" title="Forget the passphrase in this browser">Remove passphrase</button>
			</div>
			<p class="ioNote">The catalog is encrypted with this passphrase before it leaves the browser, so your server keeps only
				text it can't read. Use the same one on every device; it is kept in this browser only, and a lost passphrase can't be
				recovered (each device still has its catalog).</p>
			<p class="ioNote" id="syncPassphraseState"></p>
		</div>
		<div class="ioRow">
			<span class="ioLabel">Sync</span>
			<div class="rowbtns">
				<button class="iconbtn2" id="syncBtn" title="Take in what your other devices changed, and send what this one changed">Sync now</button>
			</div>
			<p class="ioNote">Takes in what your other devices changed since this one last synced, and sends what this one changed,
				through your server, once sync is set up on it (the docs' <em>Your server</em>). When a device and this one
				changed the same book, series or person, it asks which to keep.</p>
			<p class="ioNote" id="syncState"></p>
			<p class="ioNote" id="syncChoice" style="display:none"><span id="syncChoiceText"></span>
				<button class="iconbtn2" id="syncKeepMine" title="Keep this browser's version of what both changed">Keep this device's</button>
				<button class="iconbtn2" id="syncKeepTheirs" title="Keep the other device's version of what both changed">Keep the synced ones</button>
				<button class="iconbtn2" id="syncReplace" title="Put the synced catalog in place of this browser's">Use the synced catalog here</button></p>
		</div>
	</section>

	<section class="panel" id="setupPanel">
		<h2>Set up another device <span class="via">QR code</span></h2>
		<div class="ioRow">
			<span class="ioLabel">Settings</span>
			<div id="setupPicks" class="setupPicks"></div>
			<p class="ioNote" id="setupState"></p>
		</div>
		<div class="ioRow">
			<span class="ioLabel">QR code</span>
			<div class="rowbtns">
				<button class="iconbtn2" id="setupShowBtn" title="Show a QR code that brings the ticked settings to another device">Show QR code</button>
				<button class="iconbtn2" id="setupHideBtn" title="Hide the QR code" style="display:none">Hide</button>
			</div>
			<p class="ioNote">Scan the code with your phone's camera: it opens this page there, which asks before it saves the ticked
				settings in the phone's browser. The settings are in the link after the <code>#</code>, which browsers never send to any
				server, but anyone who sees the code can read them, so show it only to your own phone; it hides itself after two minutes.
				The catalog itself goes by sync or a backup.</p>
			<div class="setupCode" id="setupCode" style="display:none"><img id="setupQr" alt="QR code with the ticked settings"></div>
		</div>
	</section>

	<div id="importPreview" class="importPreview">
		<h3 id="importPreviewTitle"></h3>
		<p id="mergePrefer" class="mergePrefer"><label>Where both changed a book's title, author or series, or what a series or person has, keep
			<select id="mergePreferSelect"><option value="mine">this catalog's version</option><option value="backup">the backup's version</option></select></label></p>
		<div id="importPreviewBody"></div>
		<div class="formbtns">
			<button type="button" class="save" id="importConfirm">Add books</button>
			<button type="button" id="importCancel">Cancel</button>
		</div>
	</div>
	<input type="file" id="importCsvFile" accept=".csv,text/csv" style="display:none">
