{% layout 'layout' title: 'Import &amp; export' nav: 'import.html' script: 'import.js' %}
	<p class="sub" id="subtitle">Loading&hellip;</p>
	<div id="bgTask" class="bgTask" role="status" aria-live="polite"></div>
	<p id="ioStatus" class="ioStatus"></p>

	<h2 class="pageSection">This catalog</h2>

	<section class="panel" id="backupPanel">
		<h2>Backups <span class="via">JSON file</span></h2>
		<div class="ioRow">
			<span class="ioLabel">Backup</span>
			<div class="rowbtns">
				<button class="iconbtn2" id="exportBtn" title="Download a backup JSON file">Export</button>
				<button class="iconbtn2" id="importBtn" title="Restore from a backup JSON file, or from data files">Restore</button>
				<button class="iconbtn2" id="mergeBtn" title="Merge a backup from another device into this catalog">Merge</button>
				<input type="file" id="importFile" accept="application/json,.json,.txt,text/plain" multiple style="display:none">
				<input type="file" id="mergeFile" accept="application/json" style="display:none">
			</div>
			<p class="ioNote">The catalog lives in this browser only, so export a backup now and then: it has the books, the series, authors, narrators and
				publishers, and the list of books imports skip. Restore replaces the catalog with a backup, or with the data files of a catalog
				from before it lived in the browser (pick <code>books.json</code>, <code>series-info.json</code>, <code>authors.json</code>,
				<code>excluded.txt</code> and <code>not-duplicates.txt</code> together). Merge combines a backup from another device (your phone, say) with this catalog when both have changed.</p>
			<p class="ioNote backupState" id="backupState"></p>
		</div>
	</section>

	<section class="panel" id="checkPanel">
		<h2>Check</h2>
		<div class="ioRow">
			<span class="ioLabel">Check</span>
			<div class="rowbtns">
				<button class="iconbtn2" id="checkBtn" title="Check the books, series and people for problems">Check</button>
				<button class="iconbtn2" id="boxSetsBtn" title="Keep each box set as its own book and as its titles">Box sets</button>
			</div>
			<p class="ioNote">Check lists errors and anything that needs a look. Box sets keeps each box set both as its own book and
				as its titles, as imports do now; it shows what it would add before changing anything.</p>
		</div>
	</section>

	<h2 class="pageSection">External catalogs</h2>
	<p class="hint">Each import shows the other catalog's books beside yours first, and takes only what you tick: new books, what it has that
		yours lack, and, where both have a value that differs, the values you pick. Nothing is ever removed.</p>

	<section class="panel" id="audiblePanel">
		<h2>Audible <span class="via">CSV file</span></h2>
		<div class="ioRow">
			<span class="ioLabel">Import</span>
			<div class="rowbtns">
				<label>From
					<select id="audibleImportSite" title="The Audible site your library export is from">
						<option value="audible.com">audible.com</option>
						<option value="audible.co.uk">audible.co.uk</option>
						<option value="audible.de">audible.de</option>
						<option value="audible.fr">audible.fr</option>
						<option value="audible.it">audible.it</option>
						<option value="audible.es">audible.es</option>
						<option value="audible.ca">audible.ca</option>
						<option value="audible.com.au">audible.com.au</option>
						<option value="audible.in">audible.in</option>
						<option value="audible.co.jp">audible.co.jp</option>
					</select></label>
				<button class="iconbtn2" id="importAudibleBtn" title="Compare the finished books in an Audible Library Extractor CSV with this catalog">Import CSV</button>
			</div>
			<p class="ioNote">Shows the finished books in an Audible Library Extractor CSV beside this catalog's, to pick what to take.
				Pick the Audible site the export is from first: its ASINs are that site's. (Audible can't import a list of books, so there is no export.)</p>
		</div>
	</section>

	<section class="panel" id="goodreadsPanel">
		<h2>Goodreads <span class="via">CSV file</span></h2>
		<div class="ioRow">
			<span class="ioLabel">Import</span>
			<div class="rowbtns">
				<button class="iconbtn2" id="importGoodreadsBtn" title="Compare the read audiobooks in a Goodreads library export CSV with this catalog">Import CSV</button>
			</div>
			<p class="ioNote">Shows the read audiobooks in a Goodreads library export beside this catalog's, to pick what to take.</p>
		</div>
		<div class="ioRow">
			<span class="ioLabel">Export</span>
			<div class="rowbtns">
				<button class="iconbtn2" id="exportGoodreadsBtn" title="Download a CSV for Goodreads' import">Download CSV</button>
			</div>
			<p class="ioNote">A CSV of every book for Goodreads' <a href="https://www.goodreads.com/review/import" target="_blank" rel="noopener">import page</a>: on the <em>read</em> shelf, with the latest date read, genres as shelves, and the Goodreads id and ISBN of an edition so Goodreads picks that edition.</p>
		</div>
	</section>

	<section class="panel" id="hardcoverPanel">
		<h2>Hardcover <span class="via">Online</span></h2>
		<div class="ioRow">
			<span class="ioLabel">Compare</span>
			<div class="rowbtns">
				<button class="iconbtn2" id="hardcoverCompareBtn" title="Compare your Hardcover shelves with this catalog">Compare</button>
				<label>for
					<select id="hardcoverScope" title="Compare every book, or only a series' or an author's">
						<option value="">every book</option>
						<option value="series">a series</option>
						<option value="author">an author</option>
					</select></label>
				<input type="text" id="hardcoverScopeName" list="hardcoverScopeNames" placeholder="Name" autocomplete="off" style="display:none">
				<datalist id="hardcoverScopeNames"></datalist>
			</div>
			<p class="ioNote">Shows the books on your Hardcover <em>Read</em> shelf beside this catalog's, to pick what to take from Hardcover,
				and which of your books and dates read to put on your Read shelf there; for every book, or only a series' or an author's.
				Nothing on Hardcover is changed or removed.</p>
		</div>
		<div class="ioRow">
			<span class="ioLabel">Token</span>
			<div class="rowbtns">
				<input type="password" id="hardcoverToken" placeholder="Hardcover API token" autocomplete="off" spellcheck="false">
				<button class="iconbtn2" id="hardcoverTokenSave" title="Keep this token in this browser">Save token</button>
				<button class="iconbtn2" id="hardcoverTokenRemove" title="Forget the token in this browser">Remove token</button>
			</div>
			<p class="ioNote" id="hardcoverTokenState"></p>
		</div>
	</section>

	<section class="panel" id="proxyPanel">
		<h2>Catalog proxy <span class="via">Optional</span></h2>
		<div class="ioRow">
			<span class="ioLabel">Proxy</span>
			<div class="rowbtns">
				<input type="url" id="proxyUrl" placeholder="https://your-proxy.workers.dev" autocomplete="off" spellcheck="false">
				<input type="password" id="proxyKey" placeholder="Proxy key" autocomplete="off" spellcheck="false">
				<button class="iconbtn2" id="proxySave" title="Keep this proxy in this browser, and see that it answers">Save proxy</button>
				<button class="iconbtn2" id="proxyCheck" title="See that the saved proxy answers">Check</button>
				<button class="iconbtn2" id="proxyRemove" title="Forget the proxy in this browser">Remove proxy</button>
			</div>
			<p class="ioNote">Some catalogs (AudiobookDB, Audible, BookBrainz, ISFDB) don't answer web pages, so this app can only ask
				them through a proxy of your own: a small Cloudflare Worker, free, which the app's docs (<em>Catalog proxy</em>)
				show how to set up. Everything else works without it.</p>
			<p class="ioNote" id="proxyState"></p>
		</div>
	</section>

	<div id="importPreview" class="importPreview">
		<h3 id="importPreviewTitle"></h3>
		<p id="mergePrefer" class="mergePrefer"><label>Where both changed a book's title, author or series, or what a series or person has, keep
			<select id="mergePreferSelect"><option value="mine">this catalog's version</option><option value="backup">the backup's version</option></select></label></p>
		<div id="importPreviewBody"></div>
		<div class="formbtns">
			<button type="button" class="save" id="importConfirm">Add books</button>
			<button type="button" id="importCancel">Cancel</button>
		</div>
	</div>
	<input type="file" id="importCsvFile" accept=".csv,text/csv" style="display:none">
