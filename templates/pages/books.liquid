{% layout 'layout' title: 'Books' nav: 'books.html' script: 'books.js' %}
	<p class="sub" id="subtitle">Loading&hellip;</p>
	<p class="backupNudge" id="backupNudge"></p>

	<div class="controls" id="controls">
		<input type="text" id="q" placeholder="Search title, author, series, genre, ISBN&hellip;">
		<button type="button" id="filtersBtn" class="filtersBtn" aria-expanded="false" aria-controls="authorFilter genreFilter readFilter sortBy">Filters</button>
		<select id="authorFilter"><option value="">All authors</option></select>
		<select id="genreFilter"><option value="">All genres</option></select>
		<select id="readFilter"><option value="">Read any time</option></select>
		<select id="sortBy" aria-label="Order"><option value="">In series order</option><option value="read">Recently read</option><option value="added">Recently added</option></select>
	</div>

	<div class="count-row">
		<span id="resultCount"></span>
		<div class="rowbtns">
			<label class="coversToggle" title="Covers are fetched from Amazon and Open Library by the books' ASINs and ISBNs"><input type="checkbox" id="showCovers" checked> Covers</label>
			<a class="addbtn" id="toggleAdd" href="book.html#add">+ Add a book</a>
		</div>
	</div>
	<div id="bgTask" class="bgTask" role="status" aria-live="polite"></div>
	<p id="ioStatus" class="ioStatus"></p>

	<div id="results"></div>
