{
	"$schema": "https://typedoc.org/schema.json",
	"name": "Audiobook Catalog",
	// The pages' modules and the classes they import; the service worker is no API.
	"entryPoints": ["../src/*.ts", "../src/modules/*.ts"],
	"exclude": ["../src/sw.ts"],
	"tsconfig": "../tsconfig.json",
	"out": "out",
	"readme": "none"
}
